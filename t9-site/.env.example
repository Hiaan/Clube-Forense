# Para onde vão os leads e agendamentos (JSON via POST).
# Funciona com Zapier, Make, n8n, Google Apps Script (planilha), CRM etc.
LEAD_WEBHOOK_URL=

# WhatsApp da T9 só com números, com DDI e DDD. Ex.: 5511999999999
# Aparece no botão "Confirmar pelo WhatsApp" depois do agendamento.
NEXT_PUBLIC_T9_WHATSAPP=

# E-mail que recebe os leads (via FormSubmit, enviado pelo navegador do visitante).
# No primeiro envio chega um e-mail de ativação: é só clicar em "Activate Form".
# Depois da ativação, o FormSubmit informa um código que pode substituir o e-mail aqui
# para ele não ficar visível no código da página.
NEXT_PUBLIC_LEAD_EMAIL=
