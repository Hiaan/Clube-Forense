# Para onde vão os leads e agendamentos (JSON via POST).
# Funciona com Zapier, Make, n8n, Google Apps Script (planilha), CRM etc.
LEAD_WEBHOOK_URL=

# WhatsApp da T9 só com números, com DDI e DDD. Ex.: 5511999999999
# Aparece no botão "Confirmar pelo WhatsApp" depois do agendamento.
NEXT_PUBLIC_T9_WHATSAPP=

# E-mail que recebe os leads (via FormSubmit, enviado pelo navegador do visitante).
# No primeiro envio chega um e-mail de ativação: é só clicar em "Activate Form".
# Depois da ativação, o FormSubmit informa um código que pode substituir o e-mail aqui
# para ele não ficar visível no código da página.
NEXT_PUBLIC_LEAD_EMAIL=

# Chave de acesso da página /leads (lista de leads e planilha CSV).
LEADS_CHAVE=

# Criado automaticamente ao conectar um Blob store ao projeto na Vercel.
# BLOB_READ_WRITE_TOKEN=
# Use "public" só se o store tiver sido criado como público (o padrão é privado).
# LEADS_BLOB_ACCESS=private

# ---------- Painel do cliente ----------
# Criado pela Vercel ao conectar o banco da Neon ao projeto.
# DATABASE_URL=
# E-mails que entram como administradores do painel (separados por vírgula).
PAINEL_ADMINS=
# Chave do Resend para enviar os links de acesso. Sem ela, o link vai para os logs.
RESEND_API_KEY=
# Remetente (o domínio precisa estar verificado no Resend).
# PAINEL_EMAIL_REMETENTE=T9 ADS Company <painel@t9company.com.br>

# ---------- Meta Ads (Gerenciador de Anúncios) ----------
# Token do usuário do sistema do Business Manager da T9, com ads_read e as contas atribuídas.
META_ACCESS_TOKEN=
# Segredo do app da Meta (Configurações do app → Básico). Recomendado.
META_APP_SECRET=
